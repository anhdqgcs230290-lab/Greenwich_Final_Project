# Database Configuration Template
# Copy this file to .env.database and fill in your actual values

# PostgreSQL Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=uirms
DB_USER=uirms_app
DB_PASSWORD=your_secure_password_here

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=2000

# SSL Configuration (optional)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA_PATH=/path/to/ca-cert.pem
DB_SSL_KEY_PATH=/path/to/client-key.pem
DB_SSL_CERT_PATH=/path/to/client-cert.pem

# Connection String (auto-generated from above)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://uirms_app:your_secure_password_here@localhost:5432/uirms

# Logging
DB_LOG_QUERIES=false
DB_LOG_SLOW_QUERIES_MS=1000

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Cron format: Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups/uirms

# Node.js Application
NODE_ENV=development
# NODE_ENV=production

# Timezone
DB_TIMEZONE=UTC

# Notes:
# - For production, use strong passwords (min 16 characters)
# - For production, enable SSL connections
# - For production, use environment variables or secrets manager
# - Never commit actual credentials to version control
# - Update DB_PASSWORD with actual credentials before using
